        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS decide quando os widgets atualizam, em geral cerca de uma vez por minuto. Cada widget mostra a hora dos dados. Para adicionar, clique com o botão direito na mesa e escolha Editar Widgets."
          }
        }
